{
  "name": "@four/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts src/worker.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@four/contracts": "workspace:*",
    "@four/db": "workspace:*",
    "@four/game-engine": "workspace:*",
    "@socket.io/redis-streams-adapter": "0.3.1",
    "better-auth": "1.7.1",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "nodemailer": "9.0.5",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "rate-limit-redis": "6.0.1",
    "redis": "6.2.1",
    "socket.io": "4.8.3",
    "web-push": "3.6.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.1",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4"
  }
}
